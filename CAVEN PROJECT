<body>
    <header>
        <div class="logo">Cav\En</div>
        <nav>
            <a href="#home">Home</a>
            <a href="#about">About</a>
            <a href="#services">Services</a>
            <a href="#marketplace">Marketplace</a>
            <a href="#contact">Contact</a>
            <a href="#login">Login</a>
            <button class="signup-btn">Sign Up</button>
        </nav>
    </header>


<section class="services-section" id="services">
    <h2>Campus Services</h2>

    <div class="services-grid">
        <div class="service-box">
            <h3>Software Installation</h3>
            <p>Windows, Linux, Microsoft Office, Programming tools & more.</p>
        </div>

        <div class="service-box">
            <h3>Tutoring</h3>
            <p>Get help in programming, business, mathematics and more.</p>
        </div>

        <div class="service-box">
            <h3>Hair Plaiting & Henna</h3>
            <p>Campus beauty services by fellow students.</p>
        </div>

        <div class="service-box">
            <h3>Food Delivery</h3>
            <p>Order food from student vendors on campus.</p>
        </div>
    </div>
</section>



.hero {
    background: 
        linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)),
        url("test.jpg") no-repeat center center;
    background-size: cover;
    min-height: 100vh;
    color: white;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 20px;
}


.hero h1 {
    font-size: 48px;
    font-weight: 700;
    margin-bottom: 20px;
}

.hero p {
    font-size: 18px;
    opacity: 0.9;
    margin-bottom: 30px;
}

.hero button {
    background: white;
    color: #001447;
    border: none;
    padding: 12px 30px;
    margin: 10px;
    border-radius: 30px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.3s ease;
}

.hero button:hover {
    background: #ffce0b;
    transform: translateY(-3px);
}


<!-- About Section -->
    <section class="about" id="about">
        <h2>About Cav\En</h2>
        <p>
            Cav\En is a secure online marketplace created for students and staff 
            of Cavendish University Uganda to trade goods and services safely.
        </p>

        <h3>Problem We Solve</h3>
        <p>
            Trading through unofficial social media platforms exposes students 
            to fraud and security risks. Cav\En provides a trusted campus-only 
            environment for verified buyers and sellers.
        </p>
    </section>


